# Arize Phoenix Configurations
PHOENIX_COLLECTOR_ENDPOINT="http://localhost:6006"
PHOENIX_PROJECT_NAME="my-cursor-app"
PHOENIX_CLIENT_HEADERS="" # Format: api_key=your_key (Leave blank for local)

# Live assistant. The router reads this on every model call.
OPENROUTER_API_KEY=

# Hotjar behavioural telemetry. The snippet loads in the browser only when the site id is set.
# Site 1058676, snippet version 6. No feedback widget. Identity is a hash plus role, tier, and device.
VITE_HOTJAR_SITE_ID=1058676
VITE_HOTJAR_VERSION=6

# Mixpanel. NEXT_PUBLIC_MIXPANEL_TOKEN is inlined into the browser (see vite envPrefix).
# MIXPANEL_PROJECT_TOKEN is the same value for server-side use. Leave both empty to disable tracking.
NEXT_PUBLIC_MIXPANEL_TOKEN=
MIXPANEL_PROJECT_TOKEN=
MIXPANEL_SERVICE_ACCOUNT_USER=
MIXPANEL_SERVICE_ACCOUNT_PASS=
MIXPANEL_PROJECT_ID=
